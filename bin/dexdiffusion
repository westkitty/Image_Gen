#!/usr/bin/env bash
# dexdiffusion — start/stop/restart/status/open for the DexDiffusion web UI
# (operator-console on 127.0.0.1:31337). Runs on the MacBook only.
#
#   bin/dexdiffusion start     start the console if it is not already healthy
#   bin/dexdiffusion stop      stop ONLY the project-owned console process
#   bin/dexdiffusion restart   stop + start
#   bin/dexdiffusion status    read-only health report (never repairs anything)
#   bin/dexdiffusion open      start if needed, then activate the native app
#   bin/dexdiffusion doctor    read-only PASS/WARN/FAIL health check (via /api/doctor; never generates)
#
# Ownership rule: a listener on 31337 is "ours" only if its /api/version
# reports cwd == <this repo>/operator-console and its pid matches the port
# owner. Nothing else is ever signalled. Tailscale Serve is never modified.
# See DEXDIFFUSION.md.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONSOLE_DIR="$ROOT/operator-console"
PORT="${DEX_PORT:-31337}"          # DEX_PORT: test-only override
BASE="http://127.0.0.1:$PORT"
LOCAL_URL="$BASE/dexdiffusion/"
LOG="$CONSOLE_DIR/server.log"
PIDFILE="$CONSOLE_DIR/dexdiffusion.pid"
DETACH_HELPER="$ROOT/scripts/detach-process.py"
APP_PATH="/Applications/DexDiffusion.app"
IMAGES_ROOT="/Users/andrew/images_made"
SSH_TARGET="${DEX_SSH_TARGET:-westcat}"   # DEX_SSH_TARGET: test-only override
REMOTE_VENV='$HOME/Library/Caches/DexDiffusion/mflux/venv'
REMOTE_MODEL='$HOME/Library/Caches/DexDiffusion/mflux/flux2-klein-4b-4bit'
export PATH="${DEX_PATH_PREPEND:+$DEX_PATH_PREPEND:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"   # DEX_PATH_PREPEND: test-only (fake dependencies)

if [ -z "${DEX_WORKFLOW_ROOT:-}" ]; then
  if [ -d "$ROOT/../Image_Gen/sdcpp-workflow" ]; then
    export DEX_WORKFLOW_ROOT="$(cd "$ROOT/../Image_Gen/sdcpp-workflow" && pwd)"
  else
    export DEX_WORKFLOW_ROOT="$ROOT/sdcpp-workflow"
  fi
fi
export DEX_CHAT_ENABLED="${DEX_CHAT_ENABLED:-1}"

if [ -z "${OLLAMA_BASE_URL:-}" ]; then
  if [ "$(hostname -s)" = "bigmac" ]; then
    export OLLAMA_BASE_URL="http://127.0.0.1:11434"
  else
    export OLLAMA_BASE_URL="http://127.0.0.1:11436"
  fi
fi

if [ -z "${DEX_CHAT_HISTORY_ACCOUNTS:-}" ]; then
  ACCOUNTS_FILE="$HOME/Library/Application Support/DexDiffusion/chat-history-accounts.json"
  if [ -f "$ACCOUNTS_FILE" ]; then
    export DEX_CHAT_HISTORY_ACCOUNTS="$(cat "$ACCOUNTS_FILE")"
  fi
fi

# Every status probe that can block (lsof, tailscale, defaults, ssh, ...) runs under bounded(): a hard wall-clock limit that needs
# neither GNU timeout nor coreutils. The command runs in its own process group; on expiry that group (and only it) gets TERM, then KILL.
# Exit status 124 means "timed out"; callers must report such a dependency as unknown, never as down/absent/stopped. 125 means the
# bound could not be enforced (no perl), in which case the command is NOT run: there is no unbounded fallback.
PROBE_TIMEOUT="${DEX_PROBE_TIMEOUT:-4}"   # DEX_PROBE_TIMEOUT: seconds per local probe (ssh gets 3x); tests shorten it
bounded() {
  local secs="$1"; shift
  command -v perl >/dev/null 2>&1 || return 125
  perl -e '
    my $t = shift @ARGV; my $pid = fork(); exit 125 unless defined $pid;
    if (!$pid) { setpgrp(0, 0); exec { $ARGV[0] } @ARGV or exit 127; }
    my $timed_out = 0;
    $SIG{ALRM} = sub { $timed_out = 1; kill "TERM", -$pid; select(undef, undef, undef, 0.5); kill "KILL", -$pid; };
    alarm $t;
    my $r; do { $r = waitpid($pid, 0); } while ($r == -1 && !$!{ECHILD});
    alarm 0;
    exit 124 if $timed_out;
    exit(($? & 127) ? 128 + ($? & 127) : ($? >> 8));
  ' "$secs" "$@" </dev/null
}

port_pid() { (lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true) | head -1; }
version_json() { curl -fsS --max-time 2 "$BASE/api/version" 2>/dev/null; }
json_field() { python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get(sys.argv[1]); print("" if v is None else v)' "$1" 2>/dev/null; }

# Recognize only our exact dedicated SSH forwarding process from its command
# line, independently of the remote HTTP server. A stopped backend must never
# turn a known tunnel into an "unowned" listener; no unrelated PID is signalled.
owned_ssh_tunnel_pid() {
  local pid="${1:-}" cmd
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
  cmd="$(ps -o command= -p "$pid" 2>/dev/null)" || return 1
  [[ "$cmd" == *"ssh -f -N -o ExitOnForwardFailure=yes -L $PORT:127.0.0.1:31337 $SSH_TARGET" ||
     "$cmd" == *"ssh -f -N -o ExitOnForwardFailure=yes -L $PORT:localhost:31337 $SSH_TARGET" ]]
}

# Prints the pid if the port owner is this project's console or its Big Mac connection tunnel.
owned_pid() {
  local pid v cwd vpid name
  pid="${1-$(port_pid)}"; [ -n "$pid" ] || return 1   # optional $1: an already-probed listener pid (status passes its bounded probe)
  if owned_ssh_tunnel_pid "$pid"; then
    printf '%s\n' "$pid"
    return 0
  fi
  v="$(version_json)" || return 1
  name="$(printf '%s' "$v" | json_field name)"
  [ "$name" = "Image_Gen Operator Console" ] || return 1
  cwd="$(printf '%s' "$v" | json_field cwd)"
  vpid="$(printf '%s' "$v" | json_field pid)"
  if [ "$cwd" = "$CONSOLE_DIR" ] && [ "$vpid" = "$pid" ]; then
    printf '%s\n' "$pid"
    return 0
  fi
  local cmd; cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
  if [[ "$cmd" == *"ssh"* && ( "$cmd" == *"$PORT:127.0.0.1:31337"* || "$cmd" == *"$PORT:localhost:31337"* ) ]]; then
    printf '%s\n' "$pid"
    return 0
  fi
  if [[ "$cwd" = *"/operator-console" ]]; then
    printf '%s\n' "$pid"
    return 0
  fi
  return 1
}

# Liveness checks a stable identity endpoint plus the actual Studio entrypoint.
# /api/capabilities performs optional external-volume reads and may be degraded
# independently; it must never trigger destructive SSH tunnel "recovery".
healthy() {
  local version name
  version="$(version_json)" || return 1
  name="$(printf '%s' "$version" | json_field name)" || return 1
  [ "$name" = 'Image_Gen Operator Console' ] || return 1
  curl -fsS --max-time 3 -o /dev/null "$LOCAL_URL" 2>/dev/null
}

tailnet_url() {
  command -v tailscale >/dev/null 2>&1 || return 1
  local raw rc=0
  raw="$(bounded "$PROBE_TIMEOUT" tailscale serve status --json 2>/dev/null)" || rc=$?
  [ "$rc" -eq 124 ] || [ "$rc" -eq 125 ] && return 124
  [ "$rc" -eq 0 ] || return 1
  printf '%s' "$raw" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for hp, web in (d.get("Web") or {}).items():
    for mount, h in (web.get("Handlers") or {}).items():
        if (h.get("Proxy") or "").rstrip("/") in ("http://127.0.0.1:31337", "http://localhost:31337"):
            scope = "PUBLIC (Funnel enabled!)" if (d.get("AllowFunnel") or {}).get(hp) else "tailnet-only"
            print("https://%s/dexdiffusion/\t%s" % (hp.replace(":443", ""), scope)); sys.exit(0)
sys.exit(1)' 2>/dev/null
}

cmd_start() {
  if pid="$(owned_pid)" && healthy; then
    local v; v="$(version_json)"
    local cwd; cwd="$(printf '%s' "$v" | json_field cwd)"
    local vpid; vpid="$(printf '%s' "$v" | json_field pid)"
    if [ "$cwd" = "$CONSOLE_DIR" ]; then
      echo "DexDiffusion already running locally (pid $pid)."
    else
      echo "DexDiffusion already connected to Big Mac backend (tunnel pid $pid, remote pid $vpid)."
    fi
  else
    local listener
    listener="$(port_pid)"
    if [ -n "$listener" ]; then
      if [ "$(hostname -s)" != "bigmac" ] && owned_ssh_tunnel_pid "$listener"; then
        # Restore only a verified DexDiffusion tunnel, only when local HTTP is
        # unavailable AND Big Mac's own API has been proven responsive. Never
        # terminate an unknown port owner or restart a healthy backend here.
        if healthy; then
          echo "ERROR: local port responds but its API version is not recognized. Preserving listener $listener." >&2
          exit 1
        fi
        if ! bounded $((PROBE_TIMEOUT * 3)) ssh -o BatchMode=yes -o ConnectTimeout=6 "$SSH_TARGET" "curl -fsS --max-time 4 http://127.0.0.1:31337/api/version" >/dev/null 2>&1; then
          echo "ERROR: Big Mac backend unavailable; preserving DexDiffusion SSH tunnel $listener." >&2
          exit 1
        fi
        # Recheck PID ownership after the remote probe to avoid signalling a
        # replacement process if the tunnel exited while we were inspecting it.
        if [ "$(port_pid)" != "$listener" ] || ! owned_ssh_tunnel_pid "$listener"; then
          echo "ERROR: local port owner changed during recovery. Not signalling anything." >&2
          exit 1
        fi
        echo "Recovering unresponsive project-owned SSH tunnel (pid $listener)..."
        # The known tunnel was unresponsive and Big Mac is healthy; stop only
        # its exact listener PID so a new dedicated connection can be created.
        kill -TERM "$listener" 2>/dev/null || true
        for _ in 1 2 3 4 5 6 7 8; do
          [ -z "$(port_pid)" ] && break
          sleep 1
        done
        if [ -n "$(port_pid)" ]; then
          echo "ERROR: project tunnel did not relinquish port $PORT. Preserving remaining process." >&2
          exit 1
        fi
      else
        echo "ERROR: port $PORT is in use by a process that is not this checkout's operator-console or tunnel." >&2
        echo "       Owner: $(ps -o pid=,command= -p "$listener" 2>/dev/null | cut -c1-160)" >&2
        echo "       Not touching it. Stop it yourself, then rerun: bin/dexdiffusion start" >&2
        exit 1
      fi
    fi
    if [ "$(hostname -s)" = "bigmac" ]; then
      command -v node >/dev/null 2>&1 || { echo "ERROR: node not found on PATH" >&2; exit 1; }
      [ -d "$CONSOLE_DIR/node_modules" ] || { echo "ERROR: $CONSOLE_DIR/node_modules missing. Run once: (cd operator-console && npm install)" >&2; exit 1; }
      echo "Starting DexDiffusion (log: $LOG)..."
      python3 "$DETACH_HELPER" "$CONSOLE_DIR" "$LOG" node server.js
    else
      echo "Connecting to Big Mac DexDiffusion backend ($SSH_TARGET)..."
      if ! bounded $((PROBE_TIMEOUT * 3)) ssh -o BatchMode=yes -o ConnectTimeout=6 "$SSH_TARGET" "curl -fsS http://127.0.0.1:31337/api/version" >/dev/null 2>&1; then
        echo "Big Mac backend service not responding; attempting launchctl kickstart..." >&2
        bounded $((PROBE_TIMEOUT * 3)) ssh -o BatchMode=yes -o ConnectTimeout=6 "$SSH_TARGET" "launchctl kickstart -k gui/503/local.dexdiffusion.server 2>/dev/null || true" || true
        sleep 2
      fi
      ssh -f -N -o ExitOnForwardFailure=yes -L "$PORT:127.0.0.1:31337" "$SSH_TARGET"
    fi
    for _ in $(seq 1 30); do
      healthy && break
      sleep 1
    done
    if ! healthy; then
      echo "ERROR: DexDiffusion did not become healthy within 30s. Last log lines:" >&2
      if [ -f "$LOG" ]; then tail -n 20 "$LOG" >&2 || true; fi
      exit 1
    fi
    pid="$(owned_pid)"
    printf '%s\n' "$pid" >"$PIDFILE"
    local v; v="$(version_json)"
    local cwd; cwd="$(printf '%s' "$v" | json_field cwd)"
    local vpid; vpid="$(printf '%s' "$v" | json_field pid)"
    if [ "$cwd" = "$CONSOLE_DIR" ]; then
      echo "DexDiffusion started locally (pid $pid)."
    else
      echo "DexDiffusion connected to Big Mac backend (tunnel pid $pid, remote pid $vpid)."
    fi
  fi
  echo "  local:   $LOCAL_URL"
  local trc=0; t="$(tailnet_url)" || trc=$?
  if [ "$trc" -eq 0 ]; then
    echo "  tailnet: $(printf '%s' "$t" | cut -f1)  ($(printf '%s' "$t" | cut -f2))"
  elif [ "$trc" -eq 124 ]; then
    echo "  tailnet: unknown (Tailscale probe timed out)"
  else
    echo "  tailnet: Tailscale Serve route not found (see DEXDIFFUSION.md → Tailnet URL unavailable)"
  fi
}

cmd_stop() {
  local pid
  if ! pid="$(owned_pid)"; then
    if [ -n "$(port_pid)" ]; then
      echo "Port $PORT is held by a process that is not this checkout's operator-console or tunnel; not stopping it." >&2
      exit 1
    fi
    echo "DexDiffusion is not running."
    rm -f "$PIDFILE"
    return 0
  fi
  local cmd; cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
  if [[ "$cmd" == *"ssh"* && ( "$cmd" == *"$PORT:127.0.0.1:31337"* || "$cmd" == *"$PORT:localhost:31337"* ) ]]; then
    echo "Closing DexDiffusion SSH tunnel (pid $pid)..."
  else
    echo "Stopping DexDiffusion (pid $pid)..."
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 10); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "Still running after 10s; sending SIGKILL to pid $pid only."
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
  echo "Stopped."
}

cmd_status() {
  local up="DOWN" pid="" head=""
  local lraw lrc=0 lpid
  lraw="$(bounded "$PROBE_TIMEOUT" lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null)" || lrc=$?
  lpid="$(printf '%s\n' "$lraw" | head -1)"
  if [ "$lrc" -eq 124 ] || [ "$lrc" -eq 125 ]; then
    up="UNKNOWN (port probe timed out)"
  elif pid="$(owned_pid "$lpid")" && healthy; then
    local v; v="$(version_json)"
    head="$(printf '%s' "$v" | json_field gitHead)"
    local cwd; cwd="$(printf '%s' "$v" | json_field cwd)"
    if [ "$cwd" = "$CONSOLE_DIR" ]; then
      up="UP (local node)"
    else
      up="UP (Big Mac backend: $cwd, remote pid $(printf '%s' "$v" | json_field pid))"
    fi
  elif [ -n "$lpid" ]; then
    up="PORT HELD BY FOREIGN PROCESS"
  fi
  local ts ts_url="not configured" ts_scope="-" tsrc=0
  ts="$(tailnet_url)" || tsrc=$?
  if [ "$tsrc" -eq 0 ]; then ts_url="$(printf '%s' "$ts" | cut -f1)"; ts_scope="$(printf '%s' "$ts" | cut -f2)"
  elif [ "$tsrc" -eq 124 ]; then ts_url="unknown (tailscale probe timed out)"; fi
  local bind braw brc=0
  braw="$(bounded "$PROBE_TIMEOUT" lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null)" || brc=$?
  if [ "$brc" -eq 124 ] || [ "$brc" -eq 125 ]; then bind="unknown (probe timed out)"; else bind="$(printf '%s\n' "$braw" | awk 'NR>1{print $9; exit}')"; fi

  local primary="(server down)"
  if [[ "$up" == UP* ]]; then
    primary="$(curl -fsS --max-time 3 "$BASE/api/capabilities" | python3 -c '
import json,sys
t=[x for x in json.load(sys.stdin).get("modelTargets",[]) if x.get("primary")]
print("%s [%s, %s]" % (t[0]["label"], t[0]["id"], t[0]["status"]) if t else "none designated")' 2>/dev/null || echo unknown)"
  fi

  local app="MISSING" icon="-" dock="MISSING" app_rev="-" app_build="-" app_root="-"
  local repo_head; repo_head="$(bounded "$PROBE_TIMEOUT" git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf 'unknown')"
  local swift_fp; swift_fp="$(shasum -a 256 "$ROOT/native/macos/Image_Gen/ImageGenApp.swift" 2>/dev/null | cut -d' ' -f1 || true)"
  local icon_source_fp; icon_source_fp="$(shasum -a 256 "$ROOT/operator-console/public/dexdiffusion/uploads/grok_image_1775521844329.jpg" 2>/dev/null | cut -d' ' -f1 || true)"
  if [ -f "$APP_PATH/Contents/Info.plist" ]; then
    local bid; bid="$(plutil -extract CFBundleIdentifier raw "$APP_PATH/Contents/Info.plist" 2>/dev/null || printf 'unknown')"
    app="PRESENT ($bid)"
    local ahead; ahead="$(plutil -extract DexDiffusionSourceHead raw "$APP_PATH/Contents/Info.plist" 2>/dev/null || printf 'unknown')"
    local afp; afp="$(plutil -extract DexDiffusionSourceFingerprint raw "$APP_PATH/Contents/Info.plist" 2>/dev/null || printf 'unknown')"
    local installed_icon_fp; installed_icon_fp="$(plutil -extract DexDiffusionIconFingerprint raw "$APP_PATH/Contents/Info.plist" 2>/dev/null || printf 'unknown')"
    app_root="$(plutil -extract DexDiffusionProjectRoot raw "$APP_PATH/Contents/Info.plist" 2>/dev/null || printf 'unknown')"
    if [[ "$ahead" = "$repo_head" || ( "${#ahead}" -ge 7 && "$repo_head" = "$ahead"* ) ]]; then
      app_rev="HEAD $ahead (UP TO DATE vs repo ${repo_head:0:12})"
    else
      app_rev="HEAD $ahead (OUTDATED vs repo ${repo_head:0:12} — run scripts/install-macos-app.sh)"
    fi
    local arch; arch="$(file "$APP_PATH/Contents/MacOS/DexDiffusion" 2>/dev/null | grep -o 'arm64' || printf 'unknown')"
    if [ -n "$afp" ] && [ -n "$swift_fp" ] && [ "$afp" = "$swift_fp" ]; then
      app_build="$arch (source fingerprint MATCHES)"
    elif [ -n "$afp" ] && [ "$afp" != "unknown" ]; then
      app_build="$arch (SOURCE DRIFT: Swift file modified since install)"
    else
      app_build="$arch"
    fi
    local iconf; iconf="$(plutil -extract CFBundleIconFile raw "$APP_PATH/Contents/Info.plist" 2>/dev/null || true)"
    if [ -n "$iconf" ] && [ -f "$APP_PATH/Contents/Resources/${iconf%.icns}.icns" ]; then
      if [ -n "$icon_source_fp" ] && [ "$installed_icon_fp" = "$icon_source_fp" ]; then
        icon="OK (${iconf%.icns}; source artwork MATCHES)"
      else
        icon="PRESENT (${iconf%.icns}; source artwork DRIFT)"
      fi
    else
      icon="MISSING"
    fi
  fi
  local dockdump drc=0; dockdump="$(bounded "$PROBE_TIMEOUT" defaults read com.apple.dock persistent-apps 2>/dev/null)" || drc=$?
  if [ "$drc" -eq 124 ] || [ "$drc" -eq 125 ]; then
    dock="UNKNOWN (dock probe timed out)"
  else
    local n; n="$(printf '%s' "$dockdump" | grep -c "file://$APP_PATH/" || true)"
    if [ "$n" = "1" ]; then dock="INSTALLED (1 entry, file://$APP_PATH/)"; elif [ "${n:-0}" -gt 1 ] 2>/dev/null; then dock="DUPLICATE ($n entries)"; fi
    printf '%s' "$dockdump" | grep -q "Image_Gen.app/\|Image_Gen%20Launcher.app/" && dock="$dock; STALE Image_Gen entry present"
  fi

  local ssh_state="DOWN" mflux="unknown" model="unknown"
  local remote src=0
  remote="$(bounded $((PROBE_TIMEOUT * 3)) ssh -o BatchMode=yes -o ConnectTimeout=6 -o ConnectionAttempts=1 "$SSH_TARGET" \
      "printf 'HOST=%s\n' \"\$(hostname)\"; test -x $REMOTE_VENV/bin/mflux-generate-flux2 && printf 'MFLUX=PRESENT\n' || printf 'MFLUX=MISSING\n'; test -s $REMOTE_MODEL/transformer/model.safetensors.index.json && printf 'MODEL=PRESENT\n' || printf 'MODEL=MISSING\n'; bd=\$(cat \$HOME/sdcpp-staging/build_dir.txt 2>/dev/null); test -n \"\$bd\" && test -x \"\$bd/bin/sd-cli\" && printf 'SDCLI=PRESENT\n' || printf 'SDCLI=MISSING\n'; test -s \/Volumes/wc2tb/ImageGen/checkpoints/sd15/v1-5-pruned-emaonly.safetensors && printf 'SD15=PRESENT\n' || printf 'SD15=MISSING\n'; test -s /Volumes/wc2tb/ImageGen/upscalers/RealESRGAN_x4plus.pth && printf 'ESRGAN=PRESENT\n' || printf 'ESRGAN=MISSING\n'" 2>/dev/null)" || src=$?
  if [ "$src" -eq 124 ] || [ "$src" -eq 125 ]; then
    ssh_state="UNKNOWN (probe timed out)"
  elif [ "$src" -eq 0 ]; then
    ssh_state="UP ($(printf '%s' "$remote" | sed -n 's/^HOST=//p'))"
    mflux="$(printf '%s' "$remote" | sed -n 's/^MFLUX=//p')"
    model="$(printf '%s' "$remote" | sed -n 's/^MODEL=//p')"
    sdcli="$(printf '%s' "$remote" | sed -n 's/^SDCLI=//p')"
    sd15="$(printf '%s' "$remote" | sed -n 's/^SD15=//p')"
    esrgan="$(printf '%s' "$remote" | sed -n 's/^ESRGAN=//p')"
  fi
  local caps="  (server down — capability status unavailable)"
  if [[ "$up" == UP* ]]; then
    caps="$(curl -fsS --max-time 5 "$BASE/api/system-info" | python3 -c '
import json,sys
for c in json.load(sys.stdin).get("capabilities", []):
    extra = ("last pass " + c["lastPass"]["at"][:16]) if c.get("lastPass") and c["status"] == "proven" else c.get("reason", "")
    print("  %-34s %-10s %s" % (c["label"], c["status"].upper(), extra))' 2>/dev/null || echo "  (capability status unavailable)")"
  fi
  local latest lsraw lsrc=0
  lsraw="$(bounded "$PROBE_TIMEOUT" ls -t "$IMAGES_ROOT" 2>/dev/null)" || lsrc=$?
  if [ "$lsrc" -eq 124 ] || [ "$lsrc" -eq 125 ]; then latest="unavailable (probe timed out)"; else latest="$(printf '%s\n' "$lsraw" | grep -v '^\.' | head -1 || true)"; fi

  cat <<EOF
DEXDIFFUSION STATUS

Web
  status:    $up${pid:+ (pid $pid${head:+, HEAD $head})}
  local:     $LOCAL_URL
  bind:      ${bind:-none}
  tailnet:   $ts_url
  serve:     $ts_scope

Launcher
  app:       $APP_PATH — $app
  revision:  $app_rev
  build:     $app_build
  root:      $app_root
  icon:      $icon
  dock:      $dock

Generation
  primary:   $primary
  Big Mac:   ssh $SSH_TARGET — $ssh_state
  MFLUX env: $REMOTE_VENV — $mflux
  model:     mlx-community/flux2-klein-4b-4bit — $model

Storage
  images:    $IMAGES_ROOT${latest:+ (latest: $latest)} (historical MacBook originals preserved)
  durable root (Big Mac): /Volumes/wc2tb/DexDiffusion/images

SDCPP (secondary)
  sd-cli:    ${sdcli:-unknown} (\$HOME/stable-diffusion.cpp/build, rev 7f0e728)
  SD1.5:     ${sd15:-unknown} (\/Volumes/wc2tb/ImageGen/checkpoints/sd15/v1-5-pruned-emaonly.safetensors)
  ESRGAN:    ${esrgan:-unknown} (/Volumes/wc2tb/ImageGen/upscalers/RealESRGAN_x4plus.pth)

Capabilities (derived from real job evidence + asset probe)
$caps
EOF
}

# Doctor is served by the console (one implementation, reused probes).
cmd_doctor() {
  local out
  if ! out="$(curl -fsS --max-time 40 "$BASE/api/doctor" 2>/dev/null)"; then
    echo "FAIL  Operator console      not responding on $BASE (run: bin/dexdiffusion start)"
    return 1
  fi
  printf '%s' "$out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for r in d["rows"]:
    print("%-5s %-36s %s" % (r["state"], r["check"], r["detail"]))
print("\nOverall: %s  (checked %s)" % (d["overall"], d["checkedAt"]))
sys.exit(1 if d["overall"] == "FAIL" else 0)'
}

case "${1:-status}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  open)
    cmd_start >/dev/null
    if [ ! -d "$APP_PATH" ]; then
      echo "ERROR: native DexDiffusion app is missing: $APP_PATH" >&2
      echo "       Build and install it with: scripts/install-macos-app.sh" >&2
      exit 1
    fi
    /usr/bin/open -a "$APP_PATH"
    echo "Activated native DexDiffusion app: $APP_PATH"
    ;;
  doctor) cmd_doctor ;;
  -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "usage: bin/dexdiffusion {start|stop|restart|status|open|doctor}" >&2; exit 2 ;;
esac
